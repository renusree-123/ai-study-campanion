# ---------------------------------------------------------------------------
# AI Study Companion — environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL="file:./dev.db"
# Postgres (production) — also change `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/ai_study_companion?schema=public"

# --- Authentication --------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me"
AUTH_COOKIE_NAME="asc_session"
AUTH_SESSION_TTL_HOURS=168
# Set to false to lock a public demo to seeded accounts only.
ALLOW_REGISTRATION=true

# --- AI provider -----------------------------------------------------------
# OPTIONAL. Without a key the app runs on the deterministic offline provider:
# every feature still works, answers are extracted from your own materials, and
# the UI labels the provider clearly. Set this for real model responses.
ANTHROPIC_API_KEY=""

# auto = use Anthropic when a key is present, otherwise offline
AI_PROVIDER="auto"
AI_MODEL="claude-opus-5"
AI_FALLBACK_MODEL="claude-sonnet-5"
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2
# Per-user daily spend cap in USD. 0 disables the cap.
AI_DAILY_BUDGET_USD=0

# --- Storage ---------------------------------------------------------------
STORAGE_DIR="./storage"
MAX_UPLOAD_MB=20

# --- Background worker -----------------------------------------------------
# true  = worker runs inside the web process (single-process deployment)
# false = run `npm run worker` separately
WORKER_IN_PROCESS=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000

# --- Observability ---------------------------------------------------------
LOG_LEVEL="info"
